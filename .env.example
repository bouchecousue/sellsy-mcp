# Create your own Sellsy OAuth client (Private for your own organization).
# Register https://mcp.example.com/oauth/callback as its exact callback URL.
SELLSY_CLIENT_ID=
SELLSY_CLIENT_SECRET=

# Use a public HTTPS origin for remote clients. Change this before deployment.
SELLSY_MCP_PUBLIC_BASE_URL=https://mcp.example.com
SELLSY_MCP_HOST=127.0.0.1
SELLSY_MCP_PORT=8766
SELLSY_MCP_DATABASE_PATH=var/sellsy-mcp.sqlite3
SELLSY_MCP_ENCRYPTION_KEY_FILE=var/fernet.key
SELLSY_MCP_AUDIT_LOG_PATH=var/audit.jsonl

# OAuth client callbacks must use an explicitly allowed hostname.
# Extend this list only for the MCP clients you intend to trust.
SELLSY_MCP_ALLOWED_CLIENT_REDIRECT_HOSTS="chatgpt.com chat.openai.com connectors.api.openai.com localhost 127.0.0.1"

SELLSY_API_BASE_URL=https://api.sellsy.com/v2
SELLSY_OAUTH_AUTHORIZE_URL=https://login.sellsy.com/oauth2/authorization
SELLSY_OAUTH_TOKEN_URL=https://login.sellsy.com/oauth2/access-tokens

# Read-only by default. See docs/configuration.md before enabling writes.
SELLSY_MCP_ENABLE_WRITES=false
SELLSY_MCP_SELLSY_SCOPES="estimates.read estimates.write companies.read contacts.read items.read subscriptions.read staffs.read opportunities.read opportunities.write invoices.read comments.read files.read payments.read search.read credit-notes.read taxes.read orders.read deliveries.read custom-fields.read smart-tags.read"

SELLSY_MCP_SEARCH_MAX_PAGES=50
SELLSY_MCP_SEARCH_TIMEOUT_SECONDS=90
SELLSY_MCP_REQUEST_TIMEOUT_SECONDS=30
SELLSY_MCP_READ_ATTEMPTS=3
SELLSY_MCP_READ_QUEUE_LIMIT=64
SELLSY_MCP_REQUEST_CONCURRENCY=4
SELLSY_MCP_FILE_DOWNLOAD_HOSTS=[]
